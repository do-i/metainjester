# Maintainer: Ninja <ninja@renton.net>
pkgname=metainjester
pkgver=2026.8.1
pkgrel=1
pkgdesc="Catalogues a directory tree into SQLite and reports what changed on later runs"
arch=('x86_64')
url="https://github.com/do-i/metainjester"
license=('MIT')
# rusqlite links the system SQLite rather than bundling it, per design §3.
depends=('sqlite' 'gcc-libs' 'glibc')
makedepends=('cargo')
# One package per release keeps the hosted pacman repo simple.
options=('!debug')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release
}

check() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    # No tests yet by project rule; this passes trivially and is ready for them.
    cargo test --frozen --release
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm0755 -t "$pkgdir/usr/bin/" "target/release/$pkgname"
    # MIT is a per-package licence text, so Arch expects a copy shipped.
    install -Dm0644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
